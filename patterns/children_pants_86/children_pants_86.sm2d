        <data visible="true" fontSize="10" mx="7" my="55" width="10" height="5" rotation="0" quantity="1" onFold="false">
          <line text="Waist rib - cut 1" />
          <line text="Size 86 / cm" />
          <line text="Seam allowance enabled" />
          <line text="Fold lengthwise at half height" />
        </data>
        <patternInfo visible="false" />
        <grainline visible="false" />
        <nodes>
          <node idObject="87" type="NodePoint" />
          <node idObject="88" type="NodePoint" />
          <node idObject="89" type="NodePoint" />
          <node idObject="90" type="NodePoint" />
        </nodes>
      </piece>
    </pieces>
  </draftBlock>
  <draftBlock name="Ankle rib - cut 2">
    <calculation>
      <point id="92" type="single" name="CO" x="5" y="68" mx=".2" my=".2" />
      <point id="93" type="endLine" name="CEndX" basePoint="92" angle="0" length="#cuff_length" lineType="none" lineColor="black" mx=".2" my=".2" />
      <point id="94" type="endLine" name="CEnd" basePoint="93" angle="270" length="0" lineType="none" lineColor="black" mx=".2" my=".2" />
      <point id="95" type="endLine" name="CEndBottomX" basePoint="92" angle="0" length="#cuff_length" lineType="none" lineColor="black" mx=".2" my=".2" />
      <point id="96" type="endLine" name="CEndBottom" basePoint="95" angle="270" length="2*#cuff_height" lineType="none" lineColor="black" mx=".2" my=".2" />
      <point id="97" type="endLine" name="CBottomX" basePoint="92" angle="0" length="0" lineType="none" lineColor="black" mx=".2" my=".2" />
      <point id="98" type="endLine" name="CBottom" basePoint="97" angle="270" length="2*#cuff_height" lineType="none" lineColor="black" mx=".2" my=".2" />
      <line id="99" firstPoint="92" secondPoint="94" lineType="solidLine" lineColor="black" />
      <line id="100" firstPoint="94" secondPoint="96" lineType="solidLine" lineColor="black" />
      <line id="101" firstPoint="96" secondPoint="98" lineType="solidLine" lineColor="black" />
      <line id="102" firstPoint="98" secondPoint="92" lineType="solidLine" lineColor="black" />
      <point id="103" type="endLine" name="CFoldStartX" basePoint="92" angle="0" length="0" lineType="none" lineColor="black" mx=".2" my=".2" />
      <point id="104" type="endLine" name="CFoldStart" basePoint="103" angle="270" length="(2*#cuff_height)/2" lineType="none" lineColor="black" mx=".2" my=".2" />
      <point id="105" type="endLine" name="CFoldEndX" basePoint="92" angle="0" length="#cuff_length" lineType="none" lineColor="black" mx=".2" my=".2" />
      <point id="106" type="endLine" name="CFoldEnd" basePoint="105" angle="270" length="(2*#cuff_height)/2" lineType="none" lineColor="black" mx=".2" my=".2" />
      <line id="107" firstPoint="104" secondPoint="106" lineType="dashLine" lineColor="black" />
    </calculation>
    <modeling>
      <point id="108" idObject="92" type="modeling" inUse="true" mx=".2" my=".2" />
      <point id="109" idObject="94" type="modeling" inUse="true" mx=".2" my=".2" />
      <point id="110" idObject="96" type="modeling" inUse="true" mx=".2" my=".2" />
      <point id="111" idObject="98" type="modeling" inUse="true" mx=".2" my=".2" />
    </modeling>
