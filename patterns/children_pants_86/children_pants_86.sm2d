<?xml version='1.0' encoding='UTF-8'?>
<pattern>
  <version>0.7.5</version>
  <unit>cm</unit>
  <description>Size 86 barrel-inspired softshell overtrousers: full curved legs, rib waist and cuffs.</description>
  <notes>Original whole-leg redraft. Waist 62 cm, curved side 40 cm. Bow at upper knee, tapered shell opening 25.6 cm per leg. Native Beziers are editable; solved coordinates require regeneration for exact constraint balance. Previous straight-side cut pieces are not a guaranteed base for this shape. See README for research access limits and fitting notes.</notes>
  <measurements />
  <variables>
    <variable name="#size" formula="86" description="size" />
    <variable name="#waist" formula="50" description="waist" />
    <variable name="#hip" formula="55" description="hip" />
    <variable name="#outseam" formula="41" description="Dressed BODY waist-to-floor reference, not garment seam length" />
    <variable name="#inseam" formula="25" description="Dressed BODY crotch-to-floor VERTICAL reference, not seam length" />
    <variable name="#front_waist" formula="14.5" description="Front shell waist edge, seam-walked" />
    <variable name="#back_waist" formula="16.5" description="Back shell waist CURVE, seam-walked" />
    <variable name="#front_width" formula="16.5" description="Front horizontal width at hip reference" />
    <variable name="#back_width" formula="18" description="Back horizontal width at hip reference" />
    <variable name="#front_rise_target" formula="18" description="Front centre stitching line excluding ribbing" />
    <variable name="#back_rise_target" formula="23.5" description="Back centre stitching line excluding ribbing" />
    <variable name="#shell_length" formula="40" description="Full curved shell side stitching line excluding bands" />
    <variable name="#hip_depth" formula="8" description="hip depth" />
    <variable name="#hem_width" formula="12.8" description="Hem stitching-line width on EACH front and back piece" />
    <variable name="#barrel_bow" formula="2" description="Outward bow at broad upper-knee station; regenerate after edits" />
    <variable name="#barrel_level" formula="0.56" description="Bow station as fraction of shell vertical height" />
    <variable name="#hem_shift" formula="1.5" description="Horizontal outer-hem position relative to side waist" />
    <variable name="#front_extension" formula="2.75" description="front extension" />
    <variable name="#back_extension" formula="5.5" description="back extension" />
    <variable name="#band_height" formula="3" description="band height" />
    <variable name="#cuff_height" formula="3" description="cuff height" />
    <variable name="#waist_ratio" formula="0.94" description="Relaxed rib loop / body waist; provisional" />
    <variable name="#ankle" formula="16" description="Estimated ankle; provisional" />
    <variable name="#cuff_ease" formula="2" description="cuff ease" />
    <variable name="#sa" formula="1" description="sa" />
    <variable name="#hip_finished" formula="69" description="Solved result: hip finished" />
    <variable name="#hip_ease" formula="14" description="Solved result: hip ease" />
    <variable name="#hem" formula="25.6" description="Solved result: hem" />
    <variable name="#rise" formula="16.59976884595" description="Solved result: rise" />
    <variable name="#back_raise" formula="2.3567817152839" description="Solved result: back raise" />
    <variable name="#shell_vertical_height" formula="39.468268287806" description="Solved result: shell vertical height" />
    <variable name="#band_length" formula="47" description="Solved result: band length" />
    <variable name="#cuff_length" formula="18" description="Solved result: cuff length" />
    <variable name="#FO_x" formula="0" description="Solved coordinate; regenerate after design-input edits" />
    <variable name="#FO_y" formula="0" description="Solved coordinate; regenerate after design-input edits" />
    <variable name="#FSideWaist_x" formula="0" description="Solved coordinate; regenerate after design-input edits" />
    <variable name="#FSideWaist_y" formula="0" description="Solved coordinate; regenerate after design-input edits" />
    <variable name="#FWaist_x" formula="14.5" description="Solved coordinate; regenerate after design-input edits" />
    <variable name="#FWaist_y" formula="0" description="Solved coordinate; regenerate after design-input edits" />
